.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# Avoid logs
logs/

# Local Minecraft client runtime (worlds, options, caches, and downloads)
/run/

# Machine-local deployment helpers and staged mods
/build-and-deploy.sh
/mods/

# Keep track of when git fetch was last run
.git-fetch-timestamp
